{
  "name": "@rx-ted/packages-markdown-editor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Reusable markdown editor + render pipeline (dist build + standalone demo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rx-ted/app-repo.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "vitest": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./src/style.css.d.ts",
      "default": "./dist/index.css"
    },
    "./themes/*": {
      "default": "./dist/themes/*"
    }
  },
  "sideEffects": [
    "./src/index.ts",
    "./dist/index.css"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "pretest": "node scripts/build-themes.mjs",
    "build": "vite build && vite build --config vite.demo.config.ts && vue-tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prebuild": "node scripts/build-themes.mjs",
    "demo": "vite --config vite.demo.config.ts",
    "predemo": "node scripts/build-themes.mjs"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.1",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.102.0",
    "vite": "^8.0.14",
    "vitest": "4.1.7",
    "vue-tsc": "^3.3.2"
  }
}
