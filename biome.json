{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "root": true,
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "attributePosition": "auto",
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noShadowRestrictedNames": "off",
        "useIterableCallbackReturn": "off",
        "noConfusingVoidType": "off",
        "noUnsafeDeclarationMerging": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off",
        "noBannedTypes": "off",
        "noUselessConstructor": "off",
        "noThisInStatic": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noConstructorReturn": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParentheses": "always"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "html": {
    "formatter": { "enabled": true },
    "experimentalFullSupportEnabled": false
  },
  "files": {
    "includes": [
      "apps/platform-api/**",
      "apps/web-admin/**",
      "apps/web-blog/**",
      "packages/**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.next",
      "!**/coverage",
      "!**/*.min.js",
      "!**/*.gen.ts",
      "!**/*.d.ts",
      "!**/logs",
      "!**/test-results",
      "!apps/platform-api/specs/openapi.json"
    ],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": [
        "**/*.controller.ts",
        "**/*.service.ts",
        "**/*.module.ts",
        "**/*.repository.ts",
        "**/*.guard.ts",
        "**/*.consumer.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off",
            "noDescendingSpecificity": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "noUnknownPseudoClass": "off"
          },
          "a11y": {
            "useButtonType": "off",
            "noSvgWithoutTitle": "off"
          },
          "suspicious": {
            "noGlobalAssign": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          },
          "recommended": true
        }
      }
    },
    {
      "includes": ["**/*.spec.ts", "**/*.test.ts", "**/mocks/*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          },
          "complexity": {
            "useArrowFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
