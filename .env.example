# Core runtime
# DEBUG=true
# NODE_ENV=development
# DB=d1              # d1 | sqlite | mysql
# CACHE=kv           # kv | redis | local
# PORT=3000
# LOGGER_LEVEL=info  # trace | debug | info | warn | error | fatal

# ─── MySQL (when DB=mysql) ────────────────────────────────────────
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_db_password"
DB_DATABASE="rx_ted"
DB_SSL=false

# ─── SQLite (when DB=sqlite) ──────────────────────────────────────
# DB_PATH=data/app.db

# ─── Cloudflare D1 (when DB=d1) ───────────────────────────────────
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=

# ─── Redis (when CACHE=redis) ─────────────────────────────────────
# REDIS_URL=
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_USERNAME=""
REDIS_PASSWORD=""
# REDIS_DB=0

# ─── Authentication ───────────────────────────────────────────────
JWT_SECRET="your-jwt-secret"
ADMIN_USERS="admin123,admin@example.com"
# INIT_KEY=
# ANOMALY_DETECTION_MODE=off
# RATE_LIMIT_ENABLED=false

# pls access picx.19981204.xyz to apply new api-key (server-side only, for upload endpoint)
# PICX_API_KEY=px_xxx.xxx

# ─── GitHub OAuth ─────────────────────────────────────────────────
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# ─── Google OAuth ─────────────────────────────────────────────────
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# ─── Mail ─────────────────────────────────────────────────────────
# MAILS=resend,brevo,smtp

# Resend
MAIL_RESEND_API_KEY="your-resend-api-key"
MAIL_RESEND_FROM_EMAIL="noreply@19981204.xyz"
MAIL_RESEND_FROM_NAME="noreply"

# Brevo
# MAIL_BREVO_API_KEY=
MAIL_BREVO_FROM_EMAIL="noreply@19981204.xyz"
MAIL_BREVO_FROM_NAME="noreply"

# SMTP
MAIL_SMTP_HOST="smtp.example.com"
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
MAIL_SMTP_FROM_EMAIL=""   # defaults to MAIL_SMTP_USER if empty
MAIL_SMTP_FROM_NAME="rx-ted"

# ─── GitHub Integration ──────────────────────────────────────────
GITHUB_REPO_OWNER="your-github-owner"
GITHUB_REPO_NAME="your-repo-name"

# ─── Giscus (Comments) ───────────────────────────────────────────
GISCUS_REPO_ID=""
GISCUS_CATEGORY=""
GISCUS_CATEGORY_ID=""

# ─── Orama (Search) ──────────────────────────────────────────────
# ORAMA_PROJECT_ID=
# ORAMA_DATA_SOURCE_ID=
# ORAMA_WRITE_API_KEY=
# ORAMA_READ_API_KEY=

# ─── Site ────────────────────────────────────────────────────────
# FRONTEND_DOMAIN=localhost:3000
# SITE_DOMAIN=localhost:3000
# SITE_LICENSE=CC BY-NC-SA 4.0

# ─── Env override files (gitignored, create locally) ─────────────
# .env.dev  — loaded when DEBUG=true, overrides .env
#   Example: DEBUG=true, NODE_ENV=development
# .env.prod — loaded when DEBUG=false or unset, overrides .env
#   Example: NODE_ENV=production, DB_HOST=prod-db.example.com
